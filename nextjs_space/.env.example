# ==============================================================================
# ODIN'S ALMANAC - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control - it should remain local only.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Example: postgresql://postgres:password@localhost:5432/odins_almanac?schema=public
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/odins_almanac

# ------------------------------------------------------------------------------
# AUTHENTICATION (NextAuth.js)
# ------------------------------------------------------------------------------
# Secret key for NextAuth.js session encryption
# Generate a random string: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# Application URL (change for production)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# AWS S3 STORAGE
# ------------------------------------------------------------------------------
# AWS credentials profile (usually "default")
AWS_PROFILE=default

# AWS region where your S3 bucket is located
AWS_REGION=us-east-1

# S3 bucket name for file storage (labels, reports, etc.)
AWS_BUCKET_NAME=your-s3-bucket-name

# Optional folder prefix within the bucket
AWS_FOLDER_PREFIX=odins-almanac/

# ------------------------------------------------------------------------------
# STRIPE PAYMENT PROCESSING
# ------------------------------------------------------------------------------
# Get your keys from: https://dashboard.stripe.com/apikeys
# Use test keys for development (pk_test_... and sk_test_...)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# ------------------------------------------------------------------------------
# TWILIO SMS NOTIFICATIONS
# ------------------------------------------------------------------------------
# Get your credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Your Twilio phone number (format: +1234567890)
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# SENDGRID EMAIL NOTIFICATIONS
# ------------------------------------------------------------------------------
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# ------------------------------------------------------------------------------
# ABACUS.AI LLM API
# ------------------------------------------------------------------------------
# Get your API key from: https://abacus.ai/
# Used for the AllWise Navigator AI chatbot
ABACUSAI_API_KEY=your_abacus_ai_api_key_here

# ==============================================================================
# OPTIONAL CONFIGURATION
# ==============================================================================

# Node environment (development, production, test)
# NODE_ENV=development
